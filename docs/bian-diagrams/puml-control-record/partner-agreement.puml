}

class "BQ Policy Term Instance Record" as N312480 {
  + Bank Policy-Rule Type : Text
  + Applicable Bank Policy-Rule Reference : Rule Set
  + Applicable Bank Policy- Rule Interpretation : Text
}

class "Partner Agreement" as N312496 {
}

