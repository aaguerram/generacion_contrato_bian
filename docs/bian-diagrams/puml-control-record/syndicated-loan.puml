  + Postconditions : Condition
  + Syndicated Loan Facility Reference : Identifier
  + Fulfillment Reference : Identifier
  + Fulfillment Type : Text
}

class "Syndicated Loan" as N321428 {
}
note right of N321428
  BOMDiagram: Syndicated Loan BOM Diagram
end note

class "BQ Instrument Design Instance Record" as N321453 {
  + Preconditions : Condition
  + Schedule : Schedule
  + Business Service : Business Service
  + Postconditions : Condition
  + Syndicated Loan Facility Reference : Identifier
