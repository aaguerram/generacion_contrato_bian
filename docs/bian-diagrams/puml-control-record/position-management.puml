@startuml
title Position Management Control Record - BIAN UML
' Generated from BIAN Control Record diagram for machine-readable context
' Service Domain: Position Management
' Source: https://bian.org/servicelandscape-14-0-0/views/view_39802.html
' Extraction: SVG semantic extraction (svg_to_puml_control_record)
' Annotation legend:
'   <<datatype>>            -> the SVG marks this shape as UML_DataType (not a plain class)
'   BianBom: yes            -> this class/enum/datatype sits inside the SVG's
'                              dashed "BIAN BOM" grouping box
'   Extensible: yes/no      -> from the class box border color in the SVG:
'                              red border only (fill #eae8e8 / stroke #c47474) = yes,
'                              this class's attributes MAY be pulled into this
'                              diagram from its owning Service Domain if needed;
'                              fully red (fill #ff8080 / stroke #d91616) = no,
'                              extending it is not allowed. Absent = plain
'                              class (fill #ffffff / stroke #d9d9d9), not part
'                              of this distinction.
'   BQ: <name>              -> Behavior Qualifier note linked to this class
'   AssetType: <name>       -> AssetType note linked to this class
'   ControlRecord: <name>   -> ControlRecord note linked to this class
'   GenericArtifact: <name> -> GenericArtifact note linked to this class
'   HelperDiagram: <name>   -> local BOM helper-diagram box named "<Class> Helper Diagram"
'   BOMDiagram: <name>      -> cross-service-domain BOM diagram box named "<Class> BOM Diagram"
hide methods
skinparam classAttributeIconSize 0
left to right direction

class "BQ Trial Transaction Instance Record" as N281375 {
  + Trial Transaction Reference : Transaction
  + Trial Transaction Type : TransactionTypeValues
  + Trial Transaction Record : Transaction
  + Trial Transaction Amount : Amount
  + Trial Transaction Date : DateTime
  + Trial Transaction Booking Entity : InvolvedParty
  + Trail Transaction Position Impact Assessment : Assessment
}

class "CR Financial Position State Instance Record" as N281383 {
  + Position Type : Position Type
  + Position Customer Reference : InvolvedParty
  + Position Sector : Organisation
  + Position Product Type : ProductTypeValues
  + Position Definition : Text
  + Position Thresholds/Limits : Arrangement
  + Position Value : Amount
  + Position Notification Arrangement Reference : Arrangement
  + Position Notification Arrangement Record : Arrangement
  + Position Notification Business Unit Reference : Business Unit
  + Position Notification Details : Text
  + Position Notification Record : Notification
}

class "Position Management" as N281396 {
}

class "BQ Transaction Application Instance Record" as N281407 {
  + Transaction Reference : Transaction
  + Transaction Type : TransactionTypeValues
  + Transaction Record : Transaction
  + Transaction Amount : Amount
  + Transaction Date : DateTime
  + Transaction Booking Entity : InvolvedParty
  + Transaction Position Impact Assessment : Assessment
}

' Relationships
N281375 "0..*" -- "0..1" N281383
N281407 "0..*" -- "0..1" N281383

@enduml
