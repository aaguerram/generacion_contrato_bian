@startuml
title Product Design Control Record - BIAN UML
' Generated from BIAN Control Record diagram for machine-readable context
' Service Domain: Product Design
' Source: https://bian.org/servicelandscape-14-0-0/views/view_45040.html
' Extraction: SVG semantic extraction (svg_to_puml_control_record)
' Annotation legend:
'   <<datatype>>            -> the SVG marks this shape as UML_DataType (not a plain class)
'   BianBom: yes            -> this class/enum/datatype sits inside the SVG's
'                              dashed "BIAN BOM" grouping box
'   Extensible: yes/no      -> from the class box border color in the SVG:
'                              red border only (fill #eae8e8 / stroke #c47474) = yes,
'                              this class's attributes MAY be pulled into this
'                              diagram from its owning Service Domain if needed;
'                              fully red (fill #ff8080 / stroke #d91616) = no,
'                              extending it is not allowed. Absent = plain
'                              class (fill #ffffff / stroke #d9d9d9), not part
'                              of this distinction.
'   BQ: <name>              -> Behavior Qualifier note linked to this class
'   AssetType: <name>       -> AssetType note linked to this class
'   ControlRecord: <name>   -> ControlRecord note linked to this class
'   GenericArtifact: <name> -> GenericArtifact note linked to this class
'   HelperDiagram: <name>   -> local BOM helper-diagram box named "<Class> Helper Diagram"
'   BOMDiagram: <name>      -> cross-service-domain BOM diagram box named "<Class> BOM Diagram"
hide methods
skinparam classAttributeIconSize 0
left to right direction

class "BQ Testing Instance Record" as N328497 {
  + ProductandService Specification Test Reference : Test
  + ProductandService Specification Test Type : Text
  + ProductandService Specification Test Harness Reference : Object
  + ProductandService Specification Test Result : Test
  + ProductandService Specification Testing Task Reference : Task
  + ProductandService Specification Testing Task Record : Task
  + ProductandService Specification Compliance Task Reference : Task
  + ProductandService Specification Compliance Task Record : Task
  + ProductandService Specification Compliance Test Reference : Test
  + ProductandService Specification Compliance Test Type : Text
}

class "BQ Functional Requirements Instance Record" as N328509 {
  + ProductandService Specification Design Task Reference : Task
  + ProductandService Specification Design Task Record : Task
  + Market Research Data Service Reference : Service
  + Market Research Data Record : Object
  + ProductandService Feedback Record : Object
  + ProductandService Requirements Specification : Text
}

class "CR Product or Service Specification Instance Record" as N328516 {
  + ProductandService Type : Text
  + ProductandService Description : Text
  + ProductandService Specification Deployment : Object
  + Employee or Business Unit Reference : InvolvedParty
  + ProductandService Specification Deployment Configuration : Arrangement
  + ProductandService Specification Deployment Task Reference : Task
  + ProductandService Specification Deployment Task Record : Task
  + ProductandService Specification Status : Status
  + ProductandService Specification Usage : Object
  + ProductandService Specification Impact : Object
  + ProductandService Specification Version : Text
  + ProductandService Specification : Text
}

class "BQ Production Instance Record" as N328529 {
  + ProductandService Specification Operational Requirements : Requirement
  + ProductandService Specification Allowed Usage : Object
  + ProductandService Specification Usage Guidelines : Rule Set
}

class "Product Design" as N328533 {
}

' Relationships
N328509 "0..*" -- "0..1" N328516
N328497 "0..*" -- "0..1" N328516
N328529 "0..*" -- "0..1" N328516

@enduml
