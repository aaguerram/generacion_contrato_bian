@startuml
title Customer Case Management Control Record - BIAN UML
' Generated from BIAN Control Record diagram for machine-readable context
' Service Domain: Customer Case Management
' Source: https://bian.org/servicelandscape-14-0-0/views/view_42823.html
' Extraction: SVG semantic extraction (svg_to_puml_control_record)
' Annotation legend:
'   <<datatype>>            -> the SVG marks this shape as UML_DataType (not a plain class)
'   BianBom: yes            -> this class/enum/datatype sits inside the SVG's
'                              dashed "BIAN BOM" grouping box
'   Extensible: yes/no      -> from the class box border color in the SVG:
'                              red border only (fill #eae8e8 / stroke #c47474) = yes,
'                              this class's attributes MAY be pulled into this
'                              diagram from its owning Service Domain if needed;
'                              fully red (fill #ff8080 / stroke #d91616) = no,
'                              extending it is not allowed. Absent = plain
'                              class (fill #ffffff / stroke #d9d9d9), not part
'                              of this distinction.
'   BQ: <name>              -> Behavior Qualifier note linked to this class
'   AssetType: <name>       -> AssetType note linked to this class
'   ControlRecord: <name>   -> ControlRecord note linked to this class
'   GenericArtifact: <name> -> GenericArtifact note linked to this class
'   HelperDiagram: <name>   -> local BOM helper-diagram box named "<Class> Helper Diagram"
'   BOMDiagram: <name>      -> cross-service-domain BOM diagram box named "<Class> BOM Diagram"
hide methods
skinparam classAttributeIconSize 0
left to right direction

class "BQ Performance Instance Record" as N293075 {
  + Customer Case Resource Utilization : Object
  + Customer Case Loading Projections : Object
  + Customer Case Resolution Service Statistics : Object
  + Customer Case Service Statistic Type : Text
  + Customer Case Service Statistic Value : Amount
  + Customer Case Service Statistic Interpretation : Object
  + Customer Case Service Statistic Recommendation : Object
}

class "Customer Case Management" as N293084 {
}

class "CR Customer Case Management Plan Instance Record" as N293096 {
  + Customer Case Management Plan Period : DateTimePeriod
  + Customer Case Policies And Guidelines : Rule Set
  + Customer Case Service Performance Goals : Goal
  + Customer Case Service Schedule : Schedule
  + Customer Case Service Operating Configuration : Arrangement
  + Customer Case Resource Plan : Plan
  + Customer Case Training Plan : Plan
}

class "BQ Rules Instance Record" as N293105 {
  + Customer Case Decision Criterion : Rule Set
  + Customer Case Decision Criterion Definition : Text
  + Customer Case Decision Criterion Rules : Rule Set
  + Customer Case Decision Criterion Analysis : Analysis
  + Customer Case Decision Criterion History : Object
}

' Relationships
N293105 "0..*" -- "0..1" N293096
N293075 "0..*" -- "0..1" N293096

@enduml
