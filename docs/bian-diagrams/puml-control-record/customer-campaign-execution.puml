@startuml
title Customer Campaign Execution Control Record - BIAN UML
' Generated from BIAN Control Record diagram for machine-readable context
' Service Domain: Customer Campaign Execution
' Source: https://bian.org/servicelandscape-14-0-0/views/view_44056.html
' Extraction: SVG semantic extraction (svg_to_puml_control_record)
' Annotation legend:
'   <<datatype>>            -> the SVG marks this shape as UML_DataType (not a plain class)
'   BianBom: yes            -> this class/enum/datatype sits inside the SVG's
'                              dashed "BIAN BOM" grouping box
'   Extensible: yes/no      -> from the class box border color in the SVG:
'                              red border only (fill #eae8e8 / stroke #c47474) = yes,
'                              this class's attributes MAY be pulled into this
'                              diagram from its owning Service Domain if needed;
'                              fully red (fill #ff8080 / stroke #d91616) = no,
'                              extending it is not allowed. Absent = plain
'                              class (fill #ffffff / stroke #d9d9d9), not part
'                              of this distinction.
'   BQ: <name>              -> Behavior Qualifier note linked to this class
'   AssetType: <name>       -> AssetType note linked to this class
'   ControlRecord: <name>   -> ControlRecord note linked to this class
'   GenericArtifact: <name> -> GenericArtifact note linked to this class
'   HelperDiagram: <name>   -> local BOM helper-diagram box named "<Class> Helper Diagram"
'   BOMDiagram: <name>      -> cross-service-domain BOM diagram box named "<Class> BOM Diagram"
hide methods
skinparam classAttributeIconSize 0
left to right direction

class "BQ Analysis Feedback Instance Record" as N325784 {
  + Customer Campaign Procedure Analysis Result : Analysis
  + Customer Campaign Procedure Analysis Feedback Result : Text
}

class "Customer Campaign Execution" as N325788 {
}
note right of N325788
  BOMDiagram: Customer Campaign Execution BOM Diagram
end note

class "BQ Execution Instance Record" as N325808 {
  + Customer Campaign Procedure Work Task Type : Text
  + Customer Campaign Procedure Work Task Description : Text
  + Customer Campaign Procedure Work Task Work Products : WorkProduct
  + Document Directory Entry Instance Reference : Document Directory Entry
  + Customer Campaign Procedure Work Task Result : Text
  + Customer Campaign Procedure Work Task Date and Time : DateTime
}

class "BQ Candidate Selection Instance Record" as N325816 {
  + Customer Campaign Selection Criteria : Rule Set
  + Customer Campaign Candidate Employee or Business Unit Reference : InvolvedParty
  + Customer Campaign Candidate Reference : InvolvedParty
  + Customer Product and Service Directory Entry Reference : Customer Product and Service Directory Entry
  + Customer Product and Service Eligibility Profile Reference : Customer Product and Service Profile
  + Customer Relationship Lifecycle Phase Reference : Party Relationship Lifecycle Phase
}

class "CR Customer Campaign Procedure Instance Record" as N325823 {
  + Customer Campaign Type : CustomerCampaignTypeValues
  + Customer Campaign Description : Text
  + Employee or Business Unit Reference : InvolvedParty
  + Customer Campaign Procedure Set-up : Arrangement
  + Customer Campaign Procedure Version Number : Text
  + Customer Campaign Schedule : Schedule
  + Customer Campaign Consumables Inventory : Item Inventory
  + Customer Campaign Consumable Type : Text
  + Customer Campaign Consumable Holding : ItemInventoryTypeValues
  + Customer Campaign Date : DateTime
  + Customer Campaign Procedure Result : Text
  + Lead and Opportunity Description : Text
  + Lead and Opportunity Reference : Sales Lead
  + Customer Portfolio Reference : Customer Portfolio
}

