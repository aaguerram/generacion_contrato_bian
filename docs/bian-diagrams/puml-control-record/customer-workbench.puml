  + Last Update Date and Time : Text
}

class "BQ ProductandService Access Instance Record" as N288727 {
  + Customer Details/Preferences : Text
  + ProductandService Menu : Object
  + ProductandService Menu Access Log : Log
  + Access Start/End Time : DateTime
  + Customer Resident Files : Object
}

class "BQ SW Update Instance Record" as N288733 {
  + SW Update Application : Text
  + SW Update Version : Text
  + SW Update Image : Text
  + Date : DateTime
}

class "BQ Broadcast Instance Record" as N288738 {
  + Customer Workbench Broadcast Record : Object
  + Customer Workbench Broadcast Record Date and Time : DateTime
}

class "Customer Workbench" as N288743 {
}

