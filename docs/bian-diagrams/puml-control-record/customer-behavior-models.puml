@startuml
title Customer Behavior Models Control Record - BIAN UML
' Generated from BIAN Control Record diagram for machine-readable context
' Service Domain: Customer Behavior Models
' Source: https://bian.org/servicelandscape-14-0-0/views/view_33641.html
' Extraction: SVG semantic extraction (svg_to_puml_control_record)
' Annotation legend:
'   <<datatype>>            -> the SVG marks this shape as UML_DataType (not a plain class)
'   BianBom: yes            -> this class/enum/datatype sits inside the SVG's
'                              dashed "BIAN BOM" grouping box
'   Extensible: yes/no      -> from the class box border color in the SVG:
'                              red border only (fill #eae8e8 / stroke #c47474) = yes,
'                              this class's attributes MAY be pulled into this
'                              diagram from its owning Service Domain if needed;
'                              fully red (fill #ff8080 / stroke #d91616) = no,
'                              extending it is not allowed. Absent = plain
'                              class (fill #ffffff / stroke #d9d9d9), not part
'                              of this distinction.
'   BQ: <name>              -> Behavior Qualifier note linked to this class
'   AssetType: <name>       -> AssetType note linked to this class
'   ControlRecord: <name>   -> ControlRecord note linked to this class
'   GenericArtifact: <name> -> GenericArtifact note linked to this class
'   HelperDiagram: <name>   -> local BOM helper-diagram box named "<Class> Helper Diagram"
'   BOMDiagram: <name>      -> cross-service-domain BOM diagram box named "<Class> BOM Diagram"
hide methods
skinparam classAttributeIconSize 0
left to right direction

class "BQ Testing Instance Record" as N280152 {
  + Customer Behavior Model Test Reference : Model Test
  + Customer Behavior Model Test Type : String
  + Customer Behavior Model Test Harness Reference : Text
  + Customer Behavior Model Test Result : Text
  + Customer Behavior Model Testing Task Reference : Task
  + Customer Behavior Model Testing Task Record : Text
  + Customer Behavior Model Compliance Task Reference : Compliance Check
  + Customer Behavior Model Compliance Task Record : Text
  + Customer Behavior Model Compliance Test Reference : Model Test
  + Customer Behavior Model Compliance Test Type : TestTypeValues
}

class "BQ Production Instance Record" as N280164 {
  + Customer Behavior Model Operational Requirements : Requirement
  + Customer Behavior Model Allowed Usage : Model Usage
  + Customer Behavior Model Usage Guidelines : Model Usage Rule Set
}

class "Customer Behavior Models" as N280171 {
}
note right of N280171
  BOMDiagram: Customer Behavior Models BOM Diagram
end note

class "BQ Functional Requirements Instance Record" as N280187 {
  + Customer Behavior Model Design Task Reference : Task
  + Customer Behavior Model Design Task Record : Text
  + Customer/Market Data Service Reference : InvolvedParty
  + Customer/Market Data Record : Text
  + Customer Behavior Model Feedback Record : Text
  + Customer Behavior Model Requirements Specification : Text
}

class "CR Customer Behavior Model Specification Instance Record" as N280194 {
  + Customer Behavior Model Type : CustomerBehaviorModelTypeValues
  + Customer Behavior Model Purpose : Text
  + Customer Behavior Model Deployment : Arrangement
  + Employee or Business Unit Reference : InvolvedParty
  + Customer Behavior Model Deployment Configuration : Model Deployment Configuration
  + Customer Behavior Model Deployment Task Reference : Task
  + Customer Behavior Model Deployment Task Record : Text
  + Customer Behavior Model Status : Status
  + Customer Behavior Model Usage : Model Usage
  + Customer Behavior Model Impact : Model Impact
  + Customer Behavior Model Version : Text
  + Customer Behavior Model : Customer Behavior Model
}

' Relationships
N280194 "0..1" -- "0..*" N280187
N280194 "0..1" -- "0..*" N280152
N280194 "0..1" -- "0..*" N280164

@enduml
