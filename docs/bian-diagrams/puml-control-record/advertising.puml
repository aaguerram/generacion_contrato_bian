@startuml
title Advertising Control Record - BIAN UML
' Generated from BIAN Control Record diagram for machine-readable context
' Service Domain: Advertising
' Source: https://bian.org/servicelandscape-14-0-0/views/view_41914.html
' Extraction: SVG semantic extraction (svg_to_puml_v2)
' Annotation legend:
'   <<datatype>>            -> the SVG marks this shape as UML_DataType (not a plain class)
'   BianBom: yes            -> this class/enum/datatype sits inside the SVG's
'                              dashed "BIAN BOM" grouping box
'   Extensible: yes/no      -> from the class box border color in the SVG:
'                              red border only (fill #eae8e8 / stroke #c47474) = yes,
'                              this class's attributes MAY be pulled into this
'                              diagram from its owning Service Domain if needed;
'                              fully red (fill #ff8080 / stroke #d91616) = no,
'                              extending it is not allowed. Absent = plain
'                              class (fill #ffffff / stroke #d9d9d9), not part
'                              of this distinction.
'   BQ: <name>              -> Behavior Qualifier note linked to this class
'   AssetType: <name>       -> AssetType note linked to this class
'   ControlRecord: <name>   -> ControlRecord note linked to this class
'   GenericArtifact: <name> -> GenericArtifact note linked to this class
'   HelperDiagram: <name>   -> local BOM helper-diagram box named "<Class> Helper Diagram"
'   BOMDiagram: <name>      -> cross-service-domain BOM diagram box named "<Class> BOM Diagram"
hide methods
skinparam classAttributeIconSize 0
left to right direction

class "BQ Performance Assessment Instance Record" as N303778 {
  + Performance Assessment Work Task Type : Text
  + Performance Assessment Work Task : Task
  + Performance Assessment Work Task Work Products : WorkProduct
  + Performance Assessment Work Task Result : Task
  + Performance Assessment Work Task Date and Time : Date Time
}

class "Advertising" as N303785 {
}

class "BQ Campaign Direction Instance Record" as N303804 {
  + Advertising Campaign Development Schedule : Schedule
  + Advertising Campaign Execution Schedule : Schedule
}

class "CR Advertising Campaign Management Plan Instance Record" as N303808 {
  + Advertising Campaign Portfolio : Profile
  + Advertising Campaign Type : CampaignTypeValues
  + Advertising Campaign Description : Text
  + Advertising Campaign Metrics : Metric
  + Advertising Campaign Metric Definition : Text
  + Advertising Campaign Metric Goal : Goal
  + Advertising Campaign Performance Record : Object
  + Advertising Campaign Procedure Instance Reference : Identifier
  + Advertising Campaign Execution Plan : Advertising Campaign Execution Plan
  + Employee or Business Unit Reference : InvolvedParty
  + Advertising Campaign Duration : Duration
  + Advertising Campaign Procedure Result : Procedure
}

class "BQ Market Tracking Instance Record" as N303821 {
  + Market Tracking Work Task Type : Text
  + Market Tracking Work Task : Task
  + General Market Research Directory Entry Instance Reference : Identifier
  + Market Tracking Work Task Work Products : WorkProduct
  + Market Tracking Work Task Result : Task
  + Market Tracking Work Task Date and Time : Date Time
}

' Relationships
N303821 "0..*" -- "0..1" N303808
N303778 "0..*" -- "0..1" N303808
N303804 "0..*" -- "0..1" N303808

@enduml
