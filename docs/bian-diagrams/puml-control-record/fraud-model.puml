@startuml
title Fraud Model Control Record - BIAN UML
' Generated from BIAN Control Record diagram for machine-readable context
' Service Domain: Fraud Model
' Source: https://bian.org/servicelandscape-14-0-0/views/view_34503.html
' Extraction: SVG semantic extraction (svg_to_puml_control_record)
' Annotation legend:
'   <<datatype>>            -> the SVG marks this shape as UML_DataType (not a plain class)
'   BianBom: yes            -> this class/enum/datatype sits inside the SVG's
'                              dashed "BIAN BOM" grouping box
'   Extensible: yes/no      -> from the class box border color in the SVG:
'                              red border only (fill #eae8e8 / stroke #c47474) = yes,
'                              this class's attributes MAY be pulled into this
'                              diagram from its owning Service Domain if needed;
'                              fully red (fill #ff8080 / stroke #d91616) = no,
'                              extending it is not allowed. Absent = plain
'                              class (fill #ffffff / stroke #d9d9d9), not part
'                              of this distinction.
'   BQ: <name>              -> Behavior Qualifier note linked to this class
'   AssetType: <name>       -> AssetType note linked to this class
'   ControlRecord: <name>   -> ControlRecord note linked to this class
'   GenericArtifact: <name> -> GenericArtifact note linked to this class
'   HelperDiagram: <name>   -> local BOM helper-diagram box named "<Class> Helper Diagram"
'   BOMDiagram: <name>      -> cross-service-domain BOM diagram box named "<Class> BOM Diagram"
hide methods
skinparam classAttributeIconSize 0
left to right direction

class "BQ Functional Requirements Instance Record" as N312020 {
  + Fraud Model Design Task Reference : Task
  + Fraud Model Design Task Record : Task
  + Customer/Market Data Service Reference : Service
  + Customer/Market Data Record : Object
  + Fraud Model Feedback Record : Object
  + Fraud Model Requirements Specification : Text
}

class "BQ Production Instance Record" as N312028 {
  + Fraud Model Operational Requirements : Requirement
  + Fraud Model Allowed Usage : Object
  + Fraud Model Usage Guidelines : Rule Set
}

class "Fraud Model" as N312032 {
}

class "BQ Testing Instance Record" as N312048 {
  + Fraud Model Test Reference : Model Test
  + Fraud Model Test Type : Text
  + Fraud Model Test Harness Reference : Object
  + Fraud Model Test Result : Model Test
  + Fraud Model Testing Task Reference : Task
  + Fraud Model Testing Task Record : Task
  + Fraud Model Compliance Task Reference : Task
  + Fraud Model Compliance Task Record : Task
  + Fraud Model Compliance Test Reference : Test
  + Fraud Model Compliance Test Type : Text
}

class "CR Fraud Model Specification Instance Record" as N312060 {
  + Fraud Model Type : Text
  + Fraud Model Purpose : Text
  + Fraud Model Deployment : Object
  + Employee/Business Unit Reference : Business Unit
  + Fraud Model Deployment Configuration : Arrangement
  + Fraud Model Deployment Task Reference : Task
  + Fraud Model Deployment Task Record : Task
  + Fraud Model Status : Status
  + Fraud Model Usage : Model Usage
  + Fraud Model Impact : Object
  + Fraud Model Version : Text
  + Fraud Model : Fraud Model
}

' Relationships
N312020 "0..*" -- "0..1" N312060
N312048 "0..*" -- "0..1" N312060
N312028 "0..*" -- "0..1" N312060

@enduml
