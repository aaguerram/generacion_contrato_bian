@startuml
title Regulatory Reporting Control Record - BIAN UML
' Generated from BIAN Control Record diagram for machine-readable context
' Service Domain: Regulatory Reporting
' Source: https://bian.org/servicelandscape-14-0-0/views/view_42195.html
' Extraction: SVG semantic extraction (svg_to_puml_control_record)
' Annotation legend:
'   <<datatype>>            -> the SVG marks this shape as UML_DataType (not a plain class)
'   BianBom: yes            -> this class/enum/datatype sits inside the SVG's
'                              dashed "BIAN BOM" grouping box
'   Extensible: yes/no      -> from the class box border color in the SVG:
'                              red border only (fill #eae8e8 / stroke #c47474) = yes,
'                              this class's attributes MAY be pulled into this
'                              diagram from its owning Service Domain if needed;
'                              fully red (fill #ff8080 / stroke #d91616) = no,
'                              extending it is not allowed. Absent = plain
'                              class (fill #ffffff / stroke #d9d9d9), not part
'                              of this distinction.
'   BQ: <name>              -> Behavior Qualifier note linked to this class
'   AssetType: <name>       -> AssetType note linked to this class
'   ControlRecord: <name>   -> ControlRecord note linked to this class
'   GenericArtifact: <name> -> GenericArtifact note linked to this class
'   HelperDiagram: <name>   -> local BOM helper-diagram box named "<Class> Helper Diagram"
'   BOMDiagram: <name>      -> cross-service-domain BOM diagram box named "<Class> BOM Diagram"
hide methods
skinparam classAttributeIconSize 0
left to right direction

class "BQ Enquiries Instance Record" as N330715 {
  + Regulatory Enquiry : Object
  + Enquiry Business Unit Reference : Business Unit
  + Enquiry Product and Service Reference : Product
  + Enquiry Customer Reference : InvolvedParty
  + Enquiry Transaction Records : Text
  + Regulatory Enquiry Work Products : WorkProduct
  + Regulatory Enquiry Result : Object
  + Regulatory Enquiry Document Reference : Document
}

class "Regulatory Reporting" as N330724 {
}

class "BQ Consolidation Instance Record" as N330738 {
  + Regulatory Report Type Content Requirements : Text
  + Source Business Unit or Employee Reference : InvolvedParty
  + Source Product and Service Reference : Product
  + Source Customer Reference : InvolvedParty
  + Source Transaction Records : Text
}

class "BQ Authoring Instance Record" as N330745 {
  + Regulatory Report Type Compliance Reporting Requirements : Text
  + Reporting Period : DateTimePeriod
  + Reporting Business Legal Entity Reference : Organisation
  + Reporting Business Unit Reference : Business Unit
  + Regulatory Report Reference : Regulatory Report
  + Regulatory Report : Regulatory Report
  + Regulatory Report Document Reference : Document
}

class "CR Regulatory Compliance Administrative Plan Instance Record" as N330754 {
  + Regulatory Authority Reference : Regulatory Authority
  + Regulatory Reporting Schedule : Schedule
  + Regulation Reference : Regulation
  + Regulatory Report Type : ReportTypeValues
}

