@startuml
title Advertising - BIAN BOM UML
' Generated from BIAN diagram for machine-readable context
' Service Domain: Advertising
' Source image: advertising-bom-uml.svg
' BIAN source: https://bian.org/servicelandscape-14-0-0/views/view_33527.html
' Extraction: SVG semantic extraction
' Annotation legend (notes linked to a class via an SVG connector line/geometry):
'   Extensible: yes/no      -> from the class box border color in the SVG:
'                              red border only (fill #eae8e8 / stroke #c47474) = yes,
'                              this class's attributes MAY be pulled into this
'                              diagram from its owning Service Domain if needed;
'                              fully red (fill #ff8080 / stroke #d91616) = no,
'                              extending it is not allowed. Absent = plain
'                              class (fill #ffffff / stroke #d9d9d9), not part
'                              of this distinction.
'   BQ: <name>              -> Behavior Qualifier note linked to this class
'   AssetType: <name>       -> AssetType note linked to this class
'   ControlRecord: <name>   -> ControlRecord note linked to this class
'   GenericArtifact: <name> -> GenericArtifact note linked to this class
'   HelperDiagram: <name>   -> local BOM helper-diagram box named "<Class> Helper Diagram"
'   BOMDiagram: <name>      -> cross-service-domain BOM diagram box named "<Class> BOM Diagram"
hide methods
skinparam classAttributeIconSize 0
left to right direction

class "Advertising Campaign" as N110379 {
}

class "Management Plan" as N110396 {
}
note right of N110396
  HelperDiagram: Management Plan Helper Diagram
end note

class "Duty" as N110395 {
  + Duty Type : Text
  + Duty Description : Text
  + Duty Date Time : DateTime
}
note right of N110395
  BQ: Type: Duties
end note

class "Campaign" as N110425 {
  + Campaign Type : CampaignTypeValues
  + Campaign Version : Text
  + Campaign Description : Text
  + Campaign Period : DateTimePeriod
}
note right of N110425
  HelperDiagram: Campaign Helper Diagram
end note

class "Advertising Campaign Management Plan" as N110413 {
}

class "Advertising Campaign Execution Plan" as N110398 {
  + Advertising Campaign Execution Schedule : String
}
note right of N110398
  BQ: Campaign Direction
end note

class "Advertising Campaign Development Plan" as N110412 {
  + Advertising Campaign Development Schedule : String
}
note right of N110412
  BQ: Campaign Direction
end note

class "Advertising Campaign Performance Assessment" as N110383 {
}
note right of N110383
  BQ: Performance Assessment
end note

class "Market Research" as N110382 {
  + Market Research Source : Object
  + Market Research Viewpoint : MarketResearchViewpointTypeValues
  + Market Research Approach : Text
  + Market Research Period : DateTimePeriod
  + Researched Market : Market
  + Market Research Aspect Type : MarketResearchAspectTypeValues[1..*]
  + Market Research Description : Text
  + Market Research Date and Time : DateTime
}
note right of N110382
  Extensible: no
  BQ: Market Tracking
end note

