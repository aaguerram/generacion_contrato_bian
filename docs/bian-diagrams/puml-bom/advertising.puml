N110396 "0..1" -- "0..*" N110395
N110425 <|-- N110379
N110396 <|-- N110413
N110379 "0..*" -- "0..*" N110413
N110413 "0..1" -- "0..1" N110398
N110413 "0..1" -- "0..1" N110412
N110413 "0..1" -- "0..1" N110383
N110395 <|-- N110383
N110382 "Used / ToAssess / 0..*" -- "0..*" N110383
@enduml
