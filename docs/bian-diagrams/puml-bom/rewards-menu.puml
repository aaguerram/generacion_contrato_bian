class "Directory Entry" as GA <<GenericArtifact>>
class "Property" as BQT <<BehaviorQualifierType>>

class "CR Rewards Option Directory Entry Instance Record" as CRI <<ControlRecordInstance>> {
  + Rewards Option Directory Entry Description : Text
  + Rewards Option Directory Entry Schedule : Schedule
  + Rewards Option Directory Entry Selection Configuration : Arrangement
  + Rewards Option Directory Entry Reference : Identifier
  + Rewards Option Directory Entry Version Number : Number
  + Rewards Option Directory Entry Usage Log : Log
  + Rewards Option Directory Entry Update Log : Log
  + Rewards Option Directory Entry Status : Status
}

SD "1" --> "1" CRT : defines control record
CRT "1" --> "0..*" CRI : instantiated as
CRT --> GA : conforms to generic artifact
GA --> BQT : qualified by

