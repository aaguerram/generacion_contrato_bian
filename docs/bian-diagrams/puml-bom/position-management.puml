@startuml
title Position Management - BIAN BOM UML
' Generated from BIAN diagram for machine-readable context
' Service Domain: Position Management
' Source image: position-management-bom-uml.svg
' BIAN source: https://bian.org/servicelandscape-14-0-0/views/view_34807.html
' Extraction: SVG semantic extraction
' Annotation legend (notes linked to a class via an SVG connector line/geometry):
'   Extensible: yes/no      -> from the class box border color in the SVG:
'                              red border only (fill #eae8e8 / stroke #c47474) = yes,
'                              this class's attributes MAY be pulled into this
'                              diagram from its owning Service Domain if needed;
'                              fully red (fill #ff8080 / stroke #d91616) = no,
'                              extending it is not allowed. Absent = plain
'                              class (fill #ffffff / stroke #d9d9d9), not part
'                              of this distinction.
'   BQ: <name>              -> Behavior Qualifier note linked to this class
'   AssetType: <name>       -> AssetType note linked to this class
'   ControlRecord: <name>   -> ControlRecord note linked to this class
'   GenericArtifact: <name> -> GenericArtifact note linked to this class
'   HelperDiagram: <name>   -> local BOM helper-diagram box named "<Class> Helper Diagram"
'   BOMDiagram: <name>      -> cross-service-domain BOM diagram box named "<Class> BOM Diagram"
hide methods
skinparam classAttributeIconSize 0
left to right direction

class "State" as N67631 {
}
note right of N67631
  GenericArtifact: State
end note

class "Financial Position State" as N67618 {
  + Purpose : String
  + Value : String
}
note right of N67618
  ControlRecord: Financial Position State
end note

class "Financial Position" as N67598 {
  + Position Type : String
  + Position Customer Reference : String
  + Position Sector : String
  + Position Product Type : String
  + Position Definition : String
  + Position Thresholds : String
}
note right of N67598
  AssetType: Financial Position
end note

class "Measure" as N67592 {
}
note right of N67592
  BQ: Type: Measures
end note

class "Trial Transaction Impact Measure" as N67595 {
}
note right of N67595
  BQ: Trial Transaction
end note

class "Transaction Application" as N67601 {
}
note right of N67601
  BQ: Transaction Application
end note

class "Financial Transaction" as N67634 {
  + Financial Transaction Type : FinancialTransactionTypeValues
  + Financial Transaction Currency : CurrencyCode
  + Financial Transaction Amount : Amount
  + Financial Transaction From Account : Account
  + Financial Transaction Target Account : Account
  + Financial Transaction Date Time : DateTime[1..*]
}

' Relationships
N67631 <|-- N67618
N67598 "0..*" -- "0..1" N67618
N67631 "0..1" -- "0..*" N67592
N67618 "0..1" -- "0..*" N67595
N67618 "0..1" -- "0..*" N67601
N67595 "0..*" -- "0..1" N67634
N67634 "0..1" -- "0..*" N67601
@enduml
