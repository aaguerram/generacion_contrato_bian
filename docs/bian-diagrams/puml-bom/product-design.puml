@startuml
title Product Design - BIAN BOM UML
' Generated from BIAN diagram for machine-readable context
' Service Domain: Product Design
' Source image: product-design-bom-uml.svg
' BIAN source: https://bian.org/servicelandscape-14-0-0/views/view_43753.html
' Extraction: SVG semantic extraction
' Annotation legend (notes linked to a class via an SVG connector line/geometry):
'   Extensible: yes/no      -> from the class box border color in the SVG:
'                              red border only (fill #eae8e8 / stroke #c47474) = yes,
'                              this class's attributes MAY be pulled into this
'                              diagram from its owning Service Domain if needed;
'                              fully red (fill #ff8080 / stroke #d91616) = no,
'                              extending it is not allowed. Absent = plain
'                              class (fill #ffffff / stroke #d9d9d9), not part
'                              of this distinction.
'   BQ: <name>              -> Behavior Qualifier note linked to this class
'   AssetType: <name>       -> AssetType note linked to this class
'   ControlRecord: <name>   -> ControlRecord note linked to this class
'   GenericArtifact: <name> -> GenericArtifact note linked to this class
'   HelperDiagram: <name>   -> local BOM helper-diagram box named "<Class> Helper Diagram"
'   BOMDiagram: <name>      -> cross-service-domain BOM diagram box named "<Class> BOM Diagram"
hide methods
skinparam classAttributeIconSize 0
left to right direction

class "Product Design Specification" as N69201 {
  + Product Design Specification : String
}

class "Design Specification" as N69274 {
}
note right of N69274
  GenericArtifact: Specification
  HelperDiagram: Design Specification Helper Diagram
end note

class "Design Specification Aspect" as N69192 {
}
note right of N69192
  BQ: Type: Aspects
end note

class "Product" as N69195 {
  + Product Identification : ProductIdentification[1..*]
  + Product Type : BankingProductTypeValues[1..*]
  + Product Lifecycle Status : ProductStatus
  + Product Priority : Text
  + Product Description : Text
  + Product Version : Text
  + Product Name : Name
}
note right of N69195
  Extensible: yes
  AssetType: ProductandService
  HelperDiagram: Product Helper Diagram
end note

class "Product Feature" as N69221 {
  + Product Feature Type : ProductFeatureTypeValues
  + Product Feature Specification : Text
  + Product Feature Identification : Identifier
  + Product Feature Name : Name
  + Product Feature Lifecycle Status : Status
}
note right of N69221
  Extensible: yes
  HelperDiagram: Product Feature Helper Diagram
end note

class "Market" as N69338 {
}
note right of N69338
  Extensible: yes
end note

class "Market Research" as N69231 {
}
note right of N69231
  Extensible: no
  BOMDiagram: Market Research BOM Diagram
end note

class "Assessment" as N69244 {
}
note right of N69244
  Extensible: yes
  HelperDiagram: Assessment Helper Diagram
end note

class "Market Research Involvement" as N69248 {
}
note right of N69248
  Extensible: no
end note

class "Rule Set" as N69355 {
}
note right of N69355
  Extensible: yes
  HelperDiagram: Rule Set Helper Diagram
end note

class "Guideline" as N69263 {
}
note right of N69263
  Extensible: yes
end note

class "Product Requirement" as N69198 {
  + Product Requirement Type : RequirementTypeValues
  + Product Requirement Specification : String
}
note right of N69198
  BQ: Functional Requirements
  BQ: Production
  BQ: Testing
end note

enum "RequirementTypeValues" as N69309 {
  Functional Requirement
  Technical Requirement
  Operational Requirement
  Legal Requirement
  Testing Requirement
  Sales and Marketing Requirement
  Servicing Requirement
  Production Requirement
  Suitability Requirement
  Eligibility Requirement
  Processing Requirement
}

class "Requirement" as N69292 {
  + Requirement Type : String
}
note right of N69292
  Extensible: yes
end note

class "Regulation" as N69241 {
}
note right of N69241
  Extensible: yes
end note

' Relationships
N69274 <|-- N69201
N69274 "0..1" -- "0..*" N69192
N69221 "0..*" -- "0..1" N69201
N69195 -- N69221
N69231 "0..*" -- "SubjectOf / Research / 1..*" N69338
N69195 "0..*" -- "0..*" N69244
N69231 "0..1" -- "0..*" N69248
N69195 "0..*" -- "0..*" N69355
N69355 <|-- N69263
N69221 "0..1" -- "0..*" N69198
N69231 "0..*" -- "0..*" N69292
N69244 <|-- N69231
N69244 "0..*" -- "0..*" N69292
N69355 "0..*" -- "0..*" N69292
N69195 "0..1" -- "0..*" N69198
N69292 "0..1" -- N69198 : 0..*
N69355 <|-- N69241
@enduml
