@startuml
title Trade and Price Reporting - BIAN BOM UML
' Generated from BIAN diagram for machine-readable context
' Service Domain: Trade and Price Reporting
' Source image: trade-and-price-reporting-bom-uml.svg
' BIAN source: https://bian.org/servicelandscape-14-0-0/views/view_51942.html
' Extraction: SVG semantic extraction
' Annotation legend (notes linked to a class via an SVG connector line/geometry):
'   Extensible: yes/no      -> from the class box border color in the SVG:
'                              red border only (fill #eae8e8 / stroke #c47474) = yes,
'                              this class's attributes MAY be pulled into this
'                              diagram from its owning Service Domain if needed;
'                              fully red (fill #ff8080 / stroke #d91616) = no,
'                              extending it is not allowed. Absent = plain
'                              class (fill #ffffff / stroke #d9d9d9), not part
'                              of this distinction.
'   BQ: <name>              -> Behavior Qualifier note linked to this class
'   AssetType: <name>       -> AssetType note linked to this class
'   ControlRecord: <name>   -> ControlRecord note linked to this class
'   GenericArtifact: <name> -> GenericArtifact note linked to this class
'   HelperDiagram: <name>   -> local BOM helper-diagram box named "<Class> Helper Diagram"
'   BOMDiagram: <name>      -> cross-service-domain BOM diagram box named "<Class> BOM Diagram"
hide methods
skinparam classAttributeIconSize 0
left to right direction

class "Market Trade" as N199821 {
  + Trade Execute Date : DateTime
  + Trade Value Date : DateTime
  + Trade End Date : DateTime
  + Trade Identification : TradeIdentification
  + Trade Start Date : DateTime
  + Trade Asset : Asset
  + Trade Market : Market
  + Market Order : Market Order Agreement
  + Trade Commission : Fee Arrangement
}

class "Market Trade Reporting" as N199773 {
}

class "Market Trade Reporting Operating Session" as N199771 {
}

class "Session" as N199790 {
}
note right of N199790
  Extensible: yes
  GenericArtifact: Operating Session
  HelperDiagram: System- Session Helper Diagram
end note

class "System" as N199791 {
}
note right of N199791
  Extensible: yes
end note

class "Security" as N199810 {
}

class "Financial Instrument" as N199776 {
}
note right of N199776
  Extensible: yes
  HelperDiagram: Financial Instrument Helper Diagram
end note

class "Transaction" as N199833 {
}
note right of N199833
  Extensible: yes
  HelperDiagram: Transaction Helper Diagram
end note

class "TradeIdentification" as N199820 <<datatype>> {
  + Trade Identification : Identifier
  + Trade Identification Type : TradeIdentificationTypeValues
}

enum "TradeIdentificationTypeValues" as N199847 {
  Counterparty Reference
  Common Identification
  Matching Reference
  Unique Trade Identifier
  Clearing Broker Identification
  Trade Identification
}

' Relationships
N199773 "0..1" -- "0..1" N199771
N199821 "1..*" -- "1" N199771
N199791 <|-- N199773
N199790 <|-- N199771
N199776 <|-- N199810
N199833 <|-- N199821
N199821 "0..*" -- "Traded / Security / 0..1" N199810
@enduml
