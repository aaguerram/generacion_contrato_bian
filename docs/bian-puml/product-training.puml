@startuml
title Product Training - BIAN BOM UML
' Generated from BIAN diagram for machine-readable context
' Service Domain: Product Training
' Source image: product-training-bom-uml.svg
' BIAN source: https://bian.org/servicelandscape-14-0-0/views/view_52153.html
' Extraction: SVG semantic extraction
' Annotation legend (notes linked to a class via an SVG connector line/geometry):
'   Extensible: yes/no      -> from the class box border color in the SVG:
'                              red border only (fill #eae8e8 / stroke #c47474) = yes,
'                              this class's attributes MAY be pulled into this
'                              diagram from its owning Service Domain if needed;
'                              fully red (fill #ff8080 / stroke #d91616) = no,
'                              extending it is not allowed. Absent = plain
'                              class (fill #ffffff / stroke #d9d9d9), not part
'                              of this distinction.
'   BQ: <name>              -> Behavior Qualifier note linked to this class
'   AssetType: <name>       -> AssetType note linked to this class
'   ControlRecord: <name>   -> ControlRecord note linked to this class
'   GenericArtifact: <name> -> GenericArtifact note linked to this class
'   HelperDiagram: <name>   -> local BOM helper-diagram box named "<Class> Helper Diagram"
'   BOMDiagram: <name>      -> cross-service-domain BOM diagram box named "<Class> BOM Diagram"
hide methods
skinparam classAttributeIconSize 0
left to right direction

class "Procedure" as N93785 {
  + Procedure Type : ProcedureTypeValues
  + Procedure Date Time : DateTime
  + Procedure Request : Instruction
  + Procedure Schedule : Schedule
  + Procedure Status : Status
}
note right of N93785
  HelperDiagram: Procedure Helper Diagram
end note

class "Workstep" as N93794 {
  + Workstep Result : Text
  + Workstep Type : WorkstepTypeValues
  + Workstep Description : Text
  + Workstep Date Time : DateTime
  + Workstep Status : Status
  + Workstep WorkProduct : WorkProduct
}
note right of N93794
  BQ: Type: Workstep
end note

class "Product Training Procedure" as N93788 {
}
note right of N93788
  AssetType: Product Training
  ControlRecord: Product Training Procedure
end note

class "Product Training Workstep" as N93831 {
  + Product Training Workstep Type : String
}

enum "ProductTrainingWorkstepTypeValues" as N93828 {
  Content Development
  Service Scheduling
  Service Delivery
  Service Evaluation
}

class "Product" as N93791 {
}
note right of N93791
  AssetType: Product Training
  HelperDiagram: Product Helper Diagram
end note

' Relationships
N93785 -- "0..*" N93794
N93785 <|-- N93788
N93794 <|-- N93831
N93788 "0..1" -- "0..*" N93831
N93791 "0..*" -- "0..*" N93788
@enduml
