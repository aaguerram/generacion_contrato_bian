@startuml
title Enterprise Architecture - BIAN BOM UML
' Generated from BIAN diagram for machine-readable context
' Service Domain: Enterprise Architecture
' Source image: enterprise-architecture-bom-uml.svg
' BIAN source: https://bian.org/servicelandscape-14-0-0/views/view_51760.html
' Extraction: SVG semantic extraction
' Annotation legend (notes linked to a class via an SVG connector line/geometry):
'   Extensible: yes/no      -> from the class box border color in the SVG:
'                              red border only (fill #eae8e8 / stroke #c47474) = yes,
'                              this class's attributes MAY be pulled into this
'                              diagram from its owning Service Domain if needed;
'                              fully red (fill #ff8080 / stroke #d91616) = no,
'                              extending it is not allowed. Absent = plain
'                              class (fill #ffffff / stroke #d9d9d9), not part
'                              of this distinction.
'   BQ: <name>              -> Behavior Qualifier note linked to this class
'   AssetType: <name>       -> AssetType note linked to this class
'   ControlRecord: <name>   -> ControlRecord note linked to this class
'   GenericArtifact: <name> -> GenericArtifact note linked to this class
'   HelperDiagram: <name>   -> local BOM helper-diagram box named "<Class> Helper Diagram"
'   BOMDiagram: <name>      -> cross-service-domain BOM diagram box named "<Class> BOM Diagram"
hide methods
skinparam classAttributeIconSize 0
left to right direction

class "Business Architecture" as N89160 {
}
note right of N89160
  AssetType: Business Architecture
end note

class "Design Specification" as N89176 {
  + Design Specification Status : DesignSpecificationStatusTypeValues
  + Design Specification Version : Text
  + Design Specification Type : DesignSpecificationTypeValues
  + Design Specification Description : Text
  + Design Specification Schedule : Schedule
}
note right of N89176
  GenericArtifact: Specification
end note

class "Design Specification Aspect" as N89163 {
  + Design Specification Aspect Type : DesignSpecificationAspectTypeValues
}
note right of N89163
  BQ: Type: Aspect
end note

class "Business Architecture Design Specification" as N89157 {
}

class "Business Architecture Design Specification" as N89193 {
  + Business Architecture Design Specification Type : String
}

enum "BusinessArchitectureDesignSpecificationTypeValues" as N89154 {
  Organisational Model
  Business Architecture
  Information Architecture
  Application Architecture
  Technology Infrastructure
}

' Relationships
N89176 "0..1" -- "0..*" N89163
N89176 <|-- N89157
N89160 "0..1" -- "0..*" N89157
N89157 "0..1" -- "0..*" N89193
N89163 <|-- N89193
@enduml
