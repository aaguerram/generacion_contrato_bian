'                              extending it is not allowed. Absent = plain
'                              class (fill #ffffff / stroke #d9d9d9), not part
'                              of this distinction.
'   BQ: <name>              -> Behavior Qualifier note linked to this class
'   AssetType: <name>       -> AssetType note linked to this class
'   ControlRecord: <name>   -> ControlRecord note linked to this class
'   GenericArtifact: <name> -> GenericArtifact note linked to this class
'   HelperDiagram: <name>   -> local BOM helper-diagram box named "<Class> Helper Diagram"
'   BOMDiagram: <name>      -> cross-service-domain BOM diagram box named "<Class> BOM Diagram"
hide methods
skinparam classAttributeIconSize 0
left to right direction

class "Trade Matching" as N113433 {
}

class "Trade Matching Operating Session" as N113456 {
  + Trade Matching Operating Session Function : Function[1..*]
  + Trade Matching Operating Session Function Type : TradeMatchingOperatingSessionFunctionType
}

class "System" as N113503 {
}
note right of N113503
  Extensible: yes
end note

class "Session" as N113430 {
}
note right of N113430
  Extensible: yes
  GenericArtifact: Operating Session
  HelperDiagram: System- Session Helper Diagram
end note

class "Market Trade" as N113449 {
  + Trade Execute Date : DateTime
  + Trade Value Date : DateTime
  + Trade End Date : DateTime
  + Trade Identification : TradeIdentification
  + Trade Start Date : DateTime
  + Trade Asset : Asset
  + Trade Market : Market
  + Market Order : Market Order Agreement
  + Trade Commission : Fee Arrangement
}

class "TradeIdentification" as N113483 <<datatype>> {
  + Trade Identification : Identifier
  + Trade Identification Type : TradeIdentificationTypeValues
}

enum "TradeIdentificationTypeValues" as N113477 {
  Counterparty Reference
  Common Identification
  Matching Reference
  Unique Trade Identifier
  Clearing Broker Identification
  Trade Identification
}

class "Transaction" as N113494 {
}
note right of N113494
  Extensible: yes
  HelperDiagram: Transaction Helper Diagram
end note

enum "TradeMatchingOperatingSessionFunctionType" as N113436 {
  Unmatched Market Trade Escalation
  Transaction Confirmation or Affirmation
  Transaction Reporting
}

