@startuml
title Customer Tax Handling Control Record - BIAN UML
' Generated from BIAN Control Record diagram for machine-readable context
' Service Domain: Customer Tax Handling
' Source: https://bian.org/servicelandscape-14-0-0/views/view_47595.html
' Extraction: SVG semantic extraction (svg_to_puml_v2)
' Annotation legend:
'   <<datatype>>            -> the SVG marks this shape as UML_DataType (not a plain class)
'   BianBom: yes            -> this class/enum/datatype sits inside the SVG's
'                              dashed "BIAN BOM" grouping box
'   Extensible: yes/no      -> from the class box border color in the SVG:
'                              red border only (fill #eae8e8 / stroke #c47474) = yes,
'                              this class's attributes MAY be pulled into this
'                              diagram from its owning Service Domain if needed;
'                              fully red (fill #ff8080 / stroke #d91616) = no,
'                              extending it is not allowed. Absent = plain
'                              class (fill #ffffff / stroke #d9d9d9), not part
'                              of this distinction.
'   BQ: <name>              -> Behavior Qualifier note linked to this class
'   AssetType: <name>       -> AssetType note linked to this class
'   ControlRecord: <name>   -> ControlRecord note linked to this class
'   GenericArtifact: <name> -> GenericArtifact note linked to this class
'   HelperDiagram: <name>   -> local BOM helper-diagram box named "<Class> Helper Diagram"
'   BOMDiagram: <name>      -> cross-service-domain BOM diagram box named "<Class> BOM Diagram"
hide methods
skinparam classAttributeIconSize 0
left to right direction

class "BQ Consolidation Instance Record" as N299913 {
  + Product Instance Reference : Product Agreement
  + Product Arrangement Instance Report Type : ReportTypeValues
  + Product Arrangement Instance Report : Report
  + Report Options/Selection Criteria : Text
  + Report Period : DateTimePeriod
  + Report Format/Template : String
  + Report : Report
  + Customer Tax Handling Consolidation Work Products : WorkProduct
}

class "Customer Tax Handling" as N299923 {
}

class "BQ Reporting Instance Record" as N299938 {
  + Customer Tax Report Instance Reference : InvolvedParty
  + Customer Tax Report Type : ReportTypeValues
  + Customer Tax Report Period : DateTimePeriod
  + Customer Tax Report : Report
  + Customer Tax Handling Reporting Work Products : WorkProduct
}

class "BQ Analysis Instance Record" as N299944 {
  + Customer Tax Handling Analysis Work Products : WorkProduct
}

class "CR Customer Tax Obligation Facility Instance Record" as N299946 {
  + Customer Reference : InvolvedParty
  + Customer Tax Handling Arrangement Record : Tax Handling Arrangement
  + Taxation Jurisdiction Reference : Jurisdiction
  + Applicable Taxation Rule Reference : Tax Arrangement
  + Applicable Taxation Rule Definition : Text
  + Customer Tax Reporting Schedule : Schedule
}

' Relationships
N299913 "0..* / 0..1" -- N299946
N299944 "0..*" -- "0..1" N299946
N299938 "0..*" -- "0..1" N299946

@enduml
