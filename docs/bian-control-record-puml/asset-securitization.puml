  + Business Service : Business Service
  + Postconditions : Condition
  + Asset Securitization Transaction Reference : Transaction
  + Placement Reference : Task
  + Placement Type : Text
}

class "Asset Securitization" as N302262 {
}
note right of N302262
  BOMDiagram: Asset Securitization BOM Diagram
end note

class "CR Asset Securitization Transaction Instance Record" as N302285 {
