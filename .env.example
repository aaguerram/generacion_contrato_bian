# ═══════════════════════════════════════════════════════════════════════════════
#  generacion_contrato_ia_v2 — SOLO API keys. Copia este archivo a `.env`.
#  Todo lo demás (proveedores, modelos, orden de failover, umbrales, rutas) está
#  en config.yaml (versionado, sin secretos).
#  Una variable ya presente en el entorno del SO NO se pisa por el .env.
# ═══════════════════════════════════════════════════════════════════════════════

# Proveedores de modelo (una key por proveedor que uses en config.yaml -> providers.*.api_key_env)
GROQ_API_KEY=
GOOGLE_API_KEY=
HF_TOKEN=
OPENROUTER_API_KEY=
COHERE_API_KEY=          # solo embeddings (RAG vectorial); free-tier / trial key

# Opcionales (solo si los habilitas en config.yaml)
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# Observabilidad (opcional): activa el tracing en config.yaml -> observabilidad.langsmith_tracing
# LANGSMITH_API_KEY=
