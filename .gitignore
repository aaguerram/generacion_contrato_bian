.venv/
__pycache__/
*.pyc
.env
openrouter.md
claves_api.md
.cache/
# Bases del checkpointer de LangGraph: estado de corridas, nunca se versiona (y puede crecer).
*.sqlite
*.sqlite3
*.sqlite-journal
*.sqlite-wal
*.sqlite-shm

# Caché de extracción AST de graphify: es caché y está versionada por el nombre de versión del
# extractor (v0.9.49-s2 -> v0.9.61-s2 -> ...), así que cada actualización borraría cientos de
# archivos y añadiría otros tantos. El grafo, el informe y el manifiesto SÍ se versionan.
graphify-out/cache/

# Modelo canónico BIAN: artefacto DERIVADO de docs/ (19 MB, 26k nodos). Se regenera con
# `scripts/ingest_bian/ingest_bian.py`, así que no se versiona: cada regeneración añadiría otro
# blob de 19 MB al historial sin aportar nada que las fuentes no tengan ya.
docs/bian-graph/
*.vectorstore.*.json
.pytest_cache/

# salidas de los CLIs (--directorio ./salida/...). Anclado a la raíz para NO ignorar
# el paquete de adaptadores driven `src/adaptadores/salida/`.
/salida/

# artefactos de build / empaquetado
build/
dist/
*.egg-info/
.mypy_cache/
.ruff_cache/

# archivos temporales de Office (lock files al abrir .xlsx/.xlsm)
~$*

# datos crudos descargados de fuentes externas (p.ej. los 47 shards de
# bian.org que cachea scripts/bian_object_catalog/, ~146 MB) — no son
# codigo ni un artefacto versionable, se vuelven a descargar solos si faltan
/descarga/

# IDE / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# material de lineamiento (documentacion interna, no se publica en GitHub).
# Anclado a la raiz para no ignorar un futuro paquete con el mismo nombre.
/lineamiento/

# Workspace de la API: HU materializadas y salidas de cada intento. Es estado de ejecución, no
# fuente. En docker vive en un volumen; en local, aquí.
/api_datos/

# Artefactos del frontend (todo se compila DENTRO de la imagen docker).
frontend/node_modules/
frontend/dist/

# Volcados del navegador de las sesiones de depuración.
.playwright-mcp/
